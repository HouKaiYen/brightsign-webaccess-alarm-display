{
  "name": "brightsign-webaccess-alarms",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "tsx server/index.ts",
    "package:portable": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.9.0",
    "vite": "^7.3.1"
  }
}
